MEDIA_ROOT_PATH=public/media

# 媒体文件根目录配置（可选）
# Custom media directory examples
# MEDIA_ROOT_PATH=/home/user/media
# MEDIA_ROOT_PATH="C:\Users\Username\Pictures"

# FFmpeg 路径配置（可选）
# FFmpeg path configuration (optional)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFMPEG_PATH="C:\Users\Administrator\AppData\Roaming\bilibili\ffmpeg\ffmpeg.exe"
